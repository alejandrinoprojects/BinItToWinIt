<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_game_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Top-Right Floating Sound Toggle (Arcade FAB Style) -->
        <ImageButton
            android:id="@+id/btn_sound_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_sound_fab"
            android:contentDescription="@string/sound_on"
            android:elevation="6dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sound_on"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Custom Calligraphic Title Hero Logo (Clean Upscaled Transparent PNG) -->
        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="0dp"
            android:layout_height="240dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/img_logo_hero"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_sound_toggle" />

        <!-- High Score Preview Banner Badge -->
        <TextView
            android:id="@+id/tv_best_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_wind"
            android:elevation="3dp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="🏆 Best: 0 pts"
            android:textColor="@color/brand_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_app_logo" />

        <!-- Floating Action Card Sheet (MaterialCardView) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_menu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/frosted_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/frosted_glass_stroke"
            app:strokeWidth="1.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_best_score">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp">

                <!-- Player Name Header with Avatar Badge Prefix -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/enter_player_name"
                        android:src="@drawable/ic_avatar_player" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/enter_player_name"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Player Name Input Container -->
                <EditText
                    android:id="@+id/et_player_name"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_player"
                    android:drawableStart="@drawable/ic_avatar_player"
                    android:drawablePadding="12dp"
                    android:hint="e.g., EcoHero"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="16sp" />

                <!-- 'Play Game': Large Pill-Shaped 3D Primary Action Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_primary_arcade"
                    android:drawableStart="@drawable/ic_play"
                    android:drawablePadding="10dp"
                    android:elevation="4dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/play_game"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 'Leaderboard' Pill Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_leaderboard"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_secondary_arcade"
                    android:drawableStart="@drawable/ic_trophy"
                    android:drawablePadding="10dp"
                    android:elevation="2dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/leaderboard"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 'How to Play' Pill Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_secondary_arcade"
                    android:drawableStart="@drawable/ic_help"
                    android:drawablePadding="10dp"
                    android:elevation="2dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/how_to_play"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
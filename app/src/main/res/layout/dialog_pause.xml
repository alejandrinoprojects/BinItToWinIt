<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Pause Header Icon -->
        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_badge_wind"
            android:contentDescription="@string/paused"
            android:padding="12dp"
            android:src="@drawable/ic_pause" />

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/paused"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Take a breather! Your bins are waiting."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- High-Contrast Primary CTA: Resume (Bold Green) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_resume"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/btn_primary_arcade"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/resume"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Play Again / Restart Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_restart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_secondary_arcade"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/play_again"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Exit / Main Menu Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_menu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_secondary_arcade"
            android:text="@string/back_to_menu"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
